# Local development defaults
PORT=3000
NODE_ENV=development

# Firebase Authentication web-app settings (public; also used by the runtime config endpoint)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=

# Firebase UID that should receive the LMS admin role after sign-in
OWNER_FIREBASE_UID=

# MySQL-compatible database for LMS users, courses, assignments, receipts, and profiles
DATABASE_URL=

# Optional existing Manus OAuth fallback
MANUS_PROJECT_ID=
MANUS_JWT_SECRET=
MANUS_OAUTH_API_URL=
MANUS_OAUTH_PORTAL_URL=
OWNER_OPEN_ID=

# Existing upload/storage integration for receipts and lesson recordings
MANUS_API_URL=
MANUS_API_KEY=
